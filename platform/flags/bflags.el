;; ==================================================
;; blfags.el
;; Behavior Flags - variables that change significant
;; behavior in this configuration
;;
;; Part of Knavemacs configuration
;;==================================================
(setq knavemacs/BFlags--nerd-icons t) ; defines if nerd-icons should be used
(setq knavemacs/BFlags--modal-editing t) ; defines if loading modal editing
(setq knavemacs/BFlags--mini-buf-comp t) ; defines if using minibuf completions
(setq knavemacs/BFlags--modeline t) ; defines if I should use the custom modeline
(setq knavemacs/BFlags--org-super-agenda t) ; defines if org-super-agenda is being used
(setq knavemacs/BFlags--misc-visual t) ; defines various visual improvements using external packages
(setq knavemacs/BFlags--git t) ; defines loading packages related to versioning
(setq knavemacs/BFlags--snippets t) ; defines loading of snippet packages
(setq knavemacs/BFlags--completions t) ; defines loading of completion packages
